# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=yourpassword
PG_DATABASE=consent_manager

# PostgreSQL SSL/TLS (Production)
# Set PG_SSL=true to enable encrypted database connections
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# PG_SSL_CA=/path/to/root-ca.pem
# PG_SSL_CERT=/path/to/client-cert.pem
# PG_SSL_KEY=/path/to/client-key.pem

# Encryption Key (Column-Level Encryption)
# Generate with: openssl rand -hex 32
# REQUIRED for approval_token and webhook secret encryption
# ENCRYPTION_KEY=your_64_character_hex_key_here

# Server
PORT=3000

# Admin API Key (for /admin/* endpoints) - LEGACY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_secure_admin_key_here

# JWT Secret (for OAuth2/RBAC authentication)
# Generate with: openssl rand -base64 64
# JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# OAuth2 Provider Configuration (Optional - for external OAuth providers)
# OAUTH2_ISSUER=https://your-oauth-provider.com
# OAUTH2_AUDIENCE=consent-manager-api
# OAUTH2_JWKS_URI=https://your-oauth-provider.com/.well-known/jwks.json
