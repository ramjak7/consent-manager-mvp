{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.local/schemas/consent_artefact_schema.json",
  "title": "ConsentArtefact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consent_id",
    "data_principal",
    "status",
    "purposes",
    "data_categories",
    "granted_at",
    "expires_at",
    "revoked_at",
    "source",
    "legal_basis",
    "audit_reference"
  ],
  "properties": {
    "consent_id": {
      "type": "string",
      "description": "Consent artefact identifier (normative).",
      "minLength": 1
    },
    "data_principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "identifier_type"],
      "properties": {
        "principal_id": { "type": "string", "minLength": 1 },
        "identifier_type": {
          "type": "string",
          "enum": ["USER_ID", "EMAIL", "PHONE", "OTHER"]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "REVOKED", "EXPIRED", "REQUESTED", "REJECTED"],
      "description": "Consent lifecycle state."
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "List of purpose codes."
    },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "List of data category codes."
    },
    "granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when consent became ACTIVE."
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Expiry timestamp if applicable (null if none)."
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Revocation timestamp if revoked."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "language", "notice_version"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["WEB", "MOBILE_APP", "API", "OTHER"]
        },
        "language": { "type": "string", "minLength": 2 },
        "notice_version": { "type": "string", "minLength": 1 }
      }
    },
    "legal_basis": {
      "type": "string",
      "enum": ["CONSENT", "LEGITIMATE_USE", "LEGAL_OBLIGATION", "OTHER"],
      "description": "Lawful basis for processing."
    },
    "audit_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_event_id"],
      "properties": {
        "grant_event_id": { "type": "string", "minLength": 1 },
        "revoke_event_id": { "type": ["string", "null"], "minLength": 1 },
        "expiry_event_id": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  },
  "$comment": "Merged Draft-1 schema: normative structure based on Draft-2 examples, with explicit mapping expected to current DB fields (user_id, purpose, data_types, valid_until) where applicable."
}
